# Browser / Chrome
LEMAP_WEB_CDP_URL=http://127.0.0.1:9222
LEMAP_WEB_CHROME_PATH=
LEMAP_WEB_NAVIGATION_TIMEOUT_MS=15000
LEMAP_WEB_ACTION_TIMEOUT_MS=10000

# Model
LEMAP_WEB_MODEL_PROVIDER=
LEMAP_WEB_MODEL_NAME=
LEMAP_WEB_MODEL_ENDPOINT=
LEMAP_WEB_MODEL_API_KEY=

# Persistent stores
LEMAP_WEB_ENTITY_GRAPH_PATH=data/entity-graph.json
LEMAP_WEB_INSTANCE_GRAPH_PATH=data/instance-graph.json
LEMAP_WEB_WORKFLOW_LOG_PATH=data/workflows

# Runtime
LEMAP_WEB_MODE=hybrid
LEMAP_WEB_MAX_STEPS=100
LEMAP_WEB_DIAGNOSTICS=false

# Privacy is intentionally not configurable here.
# Runtime/user values never cross the model boundary and are never logged.
